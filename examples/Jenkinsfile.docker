// Build examples/Dockerfile.ci as your-registry/bear-ci:reviewed first.
// Includes validation tools, NOT cloud deployment CLIs or Docker daemon access.
pipeline {
    agent {
        docker {
            image 'your-registry/bear-ci:reviewed'
            args '--entrypoint=""'
        }
    }
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        GIT_AUTHOR_NAME = 'Bear CI'
        GIT_AUTHOR_EMAIL = 'bear-ci@example.com'
        GIT_COMMITTER_NAME = 'Bear CI'
        GIT_COMMITTER_EMAIL = 'bear-ci@example.com'
    }
    stages {
        stage('Check') {
            steps {
                script {
                    env.LOCK_ONLY = sh(
                        script: 'sh examples/ci/skip-lock-only.sh "${GIT_PREVIOUS_COMMIT:-}" "$GIT_AUTHOR_EMAIL"',
                        returnStatus: true
                    ) == 0 ? 'true' : 'false'
                }
            }
        }
        stage('Plan') {
            when { expression { env.LOCK_ONLY != 'true' } }
            steps {
                dir('examples') { sh 'bear plan prd' }
            }
        }
        stage('Deploy') {
            when {
                allOf {
                    branch 'main'
                    not { changeRequest() }
                    expression { env.LOCK_ONLY != 'true' }
                }
            }
            steps {
                withCredentials([gitUsernamePassword(
                    credentialsId: 'git-credentials', gitToolName: 'Default'
                )]) {
                    dir('examples') {
                        sh '''
                            set -eu
                            test -z "${CHANGE_ID:-}"
                            test "$BRANCH_NAME" = main
                            git check-ref-format --branch "$BRANCH_NAME" >/dev/null
                            bear apply --git-remote origin --git-branch "$BRANCH_NAME"
                        '''
                    }
                }
            }
        }
    }
    post {
        failure { echo 'Bear failed; inspect deployment and Git state before retrying.' }
        // Preserve failed deployment/Git state for operator recovery.
        success { cleanWs() }
    }
}
